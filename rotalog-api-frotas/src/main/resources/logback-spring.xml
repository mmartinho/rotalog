<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <!-- Logs em JSON no console; o correlationId do MDC sai como campo de primeiro nível -->
  <appender name="JSON" class="ch.qos.logback.core.ConsoleAppender">
    <encoder class="net.logstash.logback.encoder.LogstashEncoder">
      <customFields>{"service":"api-frotas"}</customFields>
    </encoder>
  </appender>

  <root level="INFO">
    <appender-ref ref="JSON"/>
  </root>
</configuration>
